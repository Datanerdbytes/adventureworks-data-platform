# Public Supabase project settings (never use a secret/service-role key here).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
# Legacy NEXT_PUBLIC_SUPABASE_ANON_KEY is also supported.
AUTH_APP_ORIGIN=http://127.0.0.1:8050
# Generate a random, stable secret; keep it outside version control.
FLASK_SECRET_KEY=
# Enable only after the providers are configured in Supabase.
AUTH_OAUTH_PROVIDERS=
# Privileged Postgres URL for migration/bootstrap tools only; not used by the app.
SUPABASE_DB_URL=
# Retain existing BigQuery/ADC environment settings separately.

# Explicit local mode; omit in deployment to require shared Redis storage.
RATE_LIMIT_ENVIRONMENT=development
# Configure securely in production; do not commit a credential-bearing URL.
RATE_LIMIT_REDIS_URL=
# Optional deployment-specific trusted proxy CIDRs; forwarding is ignored by default.
RATE_LIMIT_TRUSTED_PROXY_CIDRS=

# Shared local warehouse-result cache (entry budget, not a memory limit).
KPI_CACHE_THRESHOLD=500
# Maximum wait for another local worker filling the same cache stripe.
KPI_CACHE_LOCK_TIMEOUT_SECONDS=30
