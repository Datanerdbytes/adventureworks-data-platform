# The dashboard is public and reads the committed DuckDB artifact; no
# credentials or secrets are required to run it.

# Optional override for the read-only artifact location.
GOLD_DATABASE_PATH=
# Listen port. Vercel injects PORT in deployment; the container defaults to 8050.
PORT=

# Shared local warehouse-result cache (entry budget, not a memory limit).
KPI_CACHE_THRESHOLD=500
# Maximum wait for another local worker filling the same cache stripe.
KPI_CACHE_LOCK_TIMEOUT_SECONDS=30

# Retain existing BigQuery/ADC environment settings separately for
# elt_pipeline.py and dbt operator tooling; the deployed app never uses them.
